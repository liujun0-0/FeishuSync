{
  "tokenPath": "./user-token.txt",
  "wikiSpaceId": "你的飞书知识库空间ID",
  "auth": {
    "clientId": "cli_你的应用ID",
    "clientSecret": "你的应用密钥"
  },
  "sync": {
    "folderPath": "wikid",
    "mode": "local-to-remote",
    "pollIntervalSeconds": 30,
    "initialSync": true,
    "documentPolicies": {
      "paths": {
        "重要文档/只读远程.md": "remote-to-local",
        "项目说明.md": "local-to-remote",
        "共享设计.md": "merge"
      },
      "docIds": {
        "doccn_example": "bidirectional"
      }
    }
  }
}
